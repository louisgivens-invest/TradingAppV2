{
  "functions": {
    "api/t212.js":  { "memory": 256,  "maxDuration": 15 },
    "api/agent.js": { "memory": 1024, "maxDuration": 60 },
    "api/cron.js":  { "memory": 1024, "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0,15,30,45 14-20 * * 1-5"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)",       "destination": "/index.html"  }
  ]
}
